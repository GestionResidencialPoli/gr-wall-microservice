NODE_ENV=development
PORT=4100

# Debe ser el mismo secreto HMAC-SHA256 (>= 32 caracteres) configurado en gr-user-microservice (JWT_SECRET)
JWT_SECRET=

ACCESS_TOKEN_COOKIE_NAME=access_token

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mismo contenedor Postgres que usa gr-user-microservice, base de datos logica distinta
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=gr_wall_db

REDIS_URL=redis://localhost:6379
WALL_CACHE_TTL_SECONDS=30
WALL_EVENTS_CHANNEL=gr:wall:events

# user-microservice, para resolver el nombre del autor al publicar
USER_SERVICE_URL=http://localhost:8080

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
